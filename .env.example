# CodeSentinel AI Root Environment Template

# Backend Variables
PROJECT_NAME="CodeSentinel AI"
SERVICE_NAME="codesentinel-api"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"
DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/codesentinel"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Phase 1: Local Repository Ingestion Roots
LOCAL_REPOSITORY_ROOTS=""
MAX_REPOSITORY_DOWNLOAD_BYTES=52428800
MAX_REPOSITORY_EXTRACTED_BYTES=157286400
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_FILE_BYTES=2097152

# Frontend Variables
VITE_API_BASE_URL="/api"
