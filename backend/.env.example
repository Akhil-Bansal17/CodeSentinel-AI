# ==============================================================================
# CodeSentinel AI — Backend Environment Configuration Template (Phase 12)
# Safe placeholder template. Never place real passwords or secrets in version control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="CodeSentinel AI"
SERVICE_NAME="codesentinel-api"
VERSION="0.1.0"
ENVIRONMENT="development"  # Options: development | test | staging | production
DEBUG=false                # Must be false in staging and production
API_PREFIX="/api"

# Security & Secrets (REQUIRED in staging and production)
# In production: SECRET_KEY must be >= 32 cryptographically random characters
SECRET_KEY="generate-a-random-32-character-secret-key-for-production"
# In production: CI_WEBHOOK_SECRET must be >= 16 random characters
CI_WEBHOOK_SECRET="generate-a-secure-random-hmac-webhook-secret-here"
# Allowed CORS origins (comma-separated or JSON list; wildcard '*' prohibited in production)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (PostgreSQL 16+)
# Required: PostgreSQL is required for staging and production (SQLite allowed in development/test only)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/codesentinel"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Logging & Observability
LOG_LEVEL="INFO"           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"          # json (structured production) | text (development)

# Phase 1: Repository Ingestion & Limits
# Comma-separated list of permitted local folder roots (empty disables local folder ingest)
LOCAL_REPOSITORY_ROOTS=""
MAX_REPOSITORY_DOWNLOAD_BYTES=52428800    # 50 MB
MAX_REPOSITORY_EXTRACTED_BYTES=157286400  # 150 MB
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_FILE_BYTES=2097152         # 2 MB
REPOSITORY_INGESTION_TIMEOUT_SECONDS=60
REPOSITORY_HTTP_TIMEOUT_SECONDS=20
MAX_ARCHIVE_EXPANSION_RATIO=10.0

# Phase 2: Static Analysis Thresholds
MAX_ANALYSIS_FILES=1000
MAX_ANALYSIS_FILE_BYTES=1048576           # 1 MB
MAX_ANALYSIS_TOTAL_BYTES=52428800         # 50 MB
ANALYSIS_TIMEOUT_SECONDS=60
RULE_COMPLEXITY_DEFAULT_THRESHOLD=10
RULE_FUNCTION_LENGTH_DEFAULT_THRESHOLD=50
RULE_SET_VERSION="1.0.0"

# Phase 6: Code Indexing, Search & Q&A
INDEX_VERSION="1.0.0"
MAX_INDEX_FILES=1000
MAX_CHUNKS_PER_FILE=500
MAX_CHUNK_BYTES=8192
MAX_TOTAL_INDEX_BYTES=52428800
INDEXING_OVERLAP_LINES=5

# Optional Embedding Provider: 'none' (deterministic lexical fallback), 'local', 'openai_compatible', 'ollama'
EMBEDDING_PROVIDER="none"
EMBEDDING_API_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=384

# Optional LLM Provider: 'none' (deterministic citations), 'openai_compatible', 'ollama'
LLM_PROVIDER="none"
LLM_API_URL=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=30
QA_MAX_EVIDENCE_CHUNKS=8
QA_RELEVANCE_THRESHOLD=0.05
