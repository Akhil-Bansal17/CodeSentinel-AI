# CodeSentinel AI - Backend Environment Template
PROJECT_NAME="CodeSentinel AI"
SERVICE_NAME="codesentinel-api"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/codesentinel"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security & CORS (comma-separated URLs)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# Phase 1: Local Repository Ingestion Roots (comma-separated absolute paths)
# Example on Windows: LOCAL_REPOSITORY_ROOTS="C:\Users\Akhil\Projects"
# Example on Linux: LOCAL_REPOSITORY_ROOTS="/home/user/projects"
LOCAL_REPOSITORY_ROOTS=""

# Ingestion Limits
MAX_REPOSITORY_DOWNLOAD_BYTES=52428800    # 50 MB
MAX_REPOSITORY_EXTRACTED_BYTES=157286400  # 150 MB
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_FILE_BYTES=2097152         # 2 MB
REPOSITORY_INGESTION_TIMEOUT_SECONDS=60
REPOSITORY_HTTP_TIMEOUT_SECONDS=20
